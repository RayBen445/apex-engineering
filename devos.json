{
  "$schema": "https://devos.kontyra.name.ng/schema/devos.json",
  "name": "apex-engineering",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "nodeVersion": "20.x",
  "routing": {
    "cleanUrls": true,
    "fallback": "index.html"
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "ALLOWALL" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
